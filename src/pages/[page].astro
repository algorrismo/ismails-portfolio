---
import Page from '../layouts/Page.astro';
import { CornerUpLeft } from '@lucide/astro';
import { destinations } from '../data/navigation';
export function getStaticPaths() {
  return destinations.filter(destination => destination.slug !== 'experiments').map(destination => ({ params: { page: destination.slug }, props: { title: destination.title } }));
}
const { title } = Astro.props;
---
<Page title={`${title} — Ismail Hossain`}>
  <div class="page-intro"><h1 class="page-title">{title}</h1></div>
  <section class="text-section" aria-labelledby="coming-soon-title">
    <h2 id="coming-soon-title" class="section-title">Coming soon</h2>
    <p>Something is taking shape here. Check back soon.</p>
    <a class="home-link" href="/" aria-label="Back to home">
      <CornerUpLeft size={16} stroke-width={1.25} aria-hidden="true" />
    </a>
  </section>
</Page>

<style>
  .home-link {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-top: 24px;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    transition: color 150ms ease, background-color 150ms ease;
  }

  @media (hover: hover) {
    .home-link:hover {
      background-color: var(--surface);
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-link { transition: none; }
  }
</style>
