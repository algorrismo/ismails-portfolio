---
import Page from '../layouts/Page.astro';
import { CornerUpLeft } from '@lucide/astro';
import { destinations } from '../data/navigation';
import ThemeToggle from '../components/ThemeToggle.astro';
export function getStaticPaths() {
  return destinations.filter(destination => !['experiments', 'projects', 'stack'].includes(destination.slug)).map(destination => ({ params: { page: destination.slug }, props: { title: destination.title } }));
}
const { title } = Astro.props;
---
<Page title={`${title} — Ismail Hossain`}>
  <div class="page-intro"><h1 class="page-title">{title}</h1></div>
  <section class="text-section" aria-labelledby="coming-soon-title">
    <h2 id="coming-soon-title" class="section-title">Coming soon</h2>
    <p>Something is taking shape here. Check back soon.</p>
  </section>
  <footer class="page-footer">
    <a href="/"><CornerUpLeft size={16} stroke-width={1.5} aria-hidden="true" /> Back to home</a>
    <ThemeToggle />
  </footer>
</Page>
