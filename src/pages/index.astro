---
import '../styles/index.css';

const messages = [
  'Coming soon...',
  'Adding new projects soon...',
  'Updating the portfolio...',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ed" />
    <meta name="description" content="Ismail's portfolio. New projects coming soon." />
    <title>Ismail — Coming soon</title>
  </head>
  <body>
    <main>
      <section class="terminal" aria-label="Portfolio status">
        <div class="terminal-bar">
          <span class="terminal-title">ismail@linux: ~/portfolio</span>
          <span class="terminal-shell" aria-hidden="true">bash</span>
        </div>
        <div class="terminal-body">
          <h1 class="sr-only">Portfolio coming soon</h1>
          <p class="sr-only">Coming soon. Adding new projects soon. Updating the portfolio.</p>
          <div aria-hidden="true">
            {messages.map((message, index) => (
              <p class="terminal-line" style={`--characters: ${message.length}; --delay: ${index * 1.6}s`}>
                <span class="prompt">$</span><span class="typed-text">{message}</span>
              </p>
            ))}
            <p class="terminal-ready"><span class="prompt">$</span><span class="cursor"></span></p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
