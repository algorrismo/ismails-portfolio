---
import Page from '../layouts/Page.astro';
import { profile, projects, tools } from '../data/portfolio';

const icons: Record<string, string> = {
  pitch: 'M4 4h16v16H4z M12 4v16 M4 9h3v6H4 M20 9h-3v6h3 M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0',
  grid: 'M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z',
  waves: 'M3 7c3-4 6 4 9 0s6 4 9 0 M3 12c3-4 6 4 9 0s6 4 9 0 M3 17c3-4 6 4 9 0s6 4 9 0',
  chart: 'M4 4v16h16 M8 15v-3 M12 15V8 M16 15V5',
};
---
<Page>
        <div class="intro-heading">
          <h1>{profile.tagline}</h1>

        </div>
        <section id="intro" aria-labelledby="intro-title">
          <h2 id="intro-title">Intro</h2>
          <p>{profile.intro}</p>
          </section>
        <section aria-labelledby="approach-title">
          <h2 id="approach-title">How I work</h2>
          <p>I learn by building — starting with an idea, breaking it into smaller pieces, and improving it as I go. I care about clear interfaces, thoughtful details, and making things useful.</p>
        </section>
        <section aria-labelledby="curiosity-title">
          <h2 id="curiosity-title">What keeps me curious</h2>
          <p>I'm exploring the web, experimenting with new tools, and getting better with every project. This is my little space to share that progress.</p>
        </section>
        {/* Projects and everyday stack: saved for a later step.
        <div class="explore" aria-label="Explore my work">
        <details name="explore" id="work">
          <summary>Projects <span aria-hidden="true">+</span></summary>
          <section aria-labelledby="work-title" class="detail-content">
          <div class="section-heading"><h2 id="work-title">Selected work</h2><span class="section-note">A few things I've built</span></div>
          <div class="projects">
            {projects.map(project => (
              <a class="project" href={`${profile.github}/${project.repository}`} target="_blank" rel="noopener noreferrer">
                <span class={`project-icon ${project.icon}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[project.icon]} /></svg></span>
                <div class="project-copy"><h3>{project.name}<span class="sr-only"> (opens in a new tab)</span></h3><p>{project.description}</p><div class="stack">{project.stack.map(tech => <span class="stack-item"><img src={`/icons/${tech.icon}.svg`} alt="" width="14" height="14" loading="lazy" />{tech.name}</span>)}</div></div>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          <a class="text-link" href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener noreferrer">More on GitHub <span aria-hidden="true">↗</span></a>
        </section>
        </details>
        <details name="explore" id="toolbox">
          <summary>Everyday stack <span aria-hidden="true">+</span></summary>
          <section aria-labelledby="tools-title" class="detail-content">
          <div class="section-heading"><h2 id="tools-title">Tools & technologies</h2></div>
          <p>The languages, frameworks, and tools in my orbit.</p>
          <div class="toolbox-cloud">
            <ul class="tools">{tools.map((tool, index) => (
              <li style={`--float-delay: -${index * 0.47}s; --float-duration: ${4 + (index % 4) * 0.6}s`}>
                <div class="tool-tile"><span class="tool-logo"><img src={`/icons/${tool.icon}.svg`} alt="" width="30" height="30" loading="lazy" /></span><span>{tool.name}</span></div>
              </li>
            ))}</ul>
          </div>
        </section>
        </details>
        </div>
        */}
        <section id="connect" aria-labelledby="connect-title">
          <h2 id="connect-title" class="sr-only">Elsewhere</h2>

          <a class="github-link" aria-label="Ismail on GitHub (opens in a new tab)" title="GitHub" href={profile.github} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.73 2.63 1.23 3.27.94.1-.73.4-1.23.72-1.51-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.31 3.09 1.16a10.76 10.76 0 0 1 5.62 0c2.15-1.47 3.09-1.16 3.09-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.32-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z"/></svg>

          </a>
        </section>

</Page>
