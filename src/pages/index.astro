---
import Page from '../layouts/Page.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import { profile } from '../data/profile';
---
<Page>
  <div class="page-intro">
    <h1 class="page-title">{profile.tagline}</h1>
  </div>
  <section class="text-section" id="intro" aria-labelledby="intro-title">
    <h2 id="intro-title" class="section-title">Intro</h2>
    <p>{profile.intro}</p>
  </section>
  <section class="text-section" aria-labelledby="approach-title">
    <h2 id="approach-title" class="section-title">How I work</h2>
    <p>I learn by building — starting with an idea, breaking it into smaller pieces, and improving it as I go. I care about clear interfaces, thoughtful details, and making things useful.</p>
  </section>
  <section class="text-section" aria-labelledby="curiosity-title">
    <h2 id="curiosity-title" class="section-title">What keeps me curious</h2>
    <p>I'm exploring the web, experimenting with new tools, and getting better with every project. This is my little space to share that progress.</p>
  </section>
  <!-- Optional project and toolbox sections live in components/SavedWork.astro. -->
  <section class="connect-section" id="connect" aria-labelledby="connect-title">
    <h2 id="connect-title" class="sr-only">Elsewhere</h2>
    <div class="social-links">
      <a class="social-link" aria-label="Ismail on GitHub (opens in a new tab)" title="GitHub" href={profile.github} target="_blank" rel="noopener noreferrer">
        <GitHubIcon class="size-4" />
      </a>
      <a class="social-link linkedin-link" aria-label="Ismail on LinkedIn (opens in a new tab)" title="LinkedIn" href="https://www.linkedin.com/in/hello-ismail/" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.74H4.96V9.2h2.97v9.54ZM6.45 7.9a1.72 1.72 0 1 1 0-3.44 1.72 1.72 0 0 1 0 3.44Zm12.3 10.84h-2.96V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.72H9.49V9.2h2.84v1.3h.04c.4-.75 1.36-1.55 2.8-1.55 3 0 3.57 1.98 3.57 4.56v5.23Z" /></svg>
      </a>
    </div>
    <ThemeToggle />
  </section>
</Page>

<style>
  .linkedin-link { color: var(--brand-linkedin); }
</style>
