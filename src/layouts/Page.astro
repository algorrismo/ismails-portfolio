---
import '../styles/index.css';
import Header from '../components/Header.astro';
interface Props { title?: string; }
const { title = 'Ismail Hossain — Developer' } = Astro.props;
---
<!doctype html>
<html lang="en" class="bg-background font-sans text-ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fcfcfc" />
    <meta name="description" content="Ismail Hossain's personal portfolio. Web interfaces, software projects, and experiments in code." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Building things. Learning along the way. Explore my projects and personal corner of the web." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/editorial-new-italic.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      const dark = matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#111111' : '#fcfcfc');
    </script>
  </head>
  <body class="text-base antialiased">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-4 focus:z-2 focus:bg-background focus:px-3.5 focus:py-2" href="#main">Skip to content</a>
    <div class="site-shell">
      <Header />
      <main id="main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
