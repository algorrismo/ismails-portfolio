---
// Optional homepage sections; kept separate from the minimal landing page.
import ProjectList from './work/ProjectList.astro';
import Toolbox from './work/Toolbox.astro';
---
<div aria-label="Explore my work">
  <details name="explore" id="work">
    <summary>Projects <span aria-hidden="true">+</span></summary>
    <ProjectList />
  </details>

  <details name="explore" id="toolbox">
    <summary>Everyday stack <span aria-hidden="true">+</span></summary>
    <Toolbox />
  </details>
</div>
