---
import {
  ArrowUpRight, BookOpen, Coffee, FlaskConical, Folder,
  Layers, LayoutGrid, X,
} from '@lucide/astro';
import HeaderDropdown from './HeaderDropdown.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/portfolio';
import { destinations } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const navigationIcons: Record<string, typeof Folder> = {
  projects: Folder,
  stack: Layers,
  notes: BookOpen,
  uses: Coffee,
  experiments: FlaskConical,
};
const rowClass = 'group flex min-h-11 w-full items-center gap-3 rounded-md bg-transparent px-3 py-2 text-left text-sm leading-5 text-ink hover:bg-surface aria-[current=page]:bg-surface focus-visible:-outline-offset-2';
---
<header class="site-header">
  <a href="/" class="identity" aria-label={`${profile.name}, home`}>
    <img class="size-8 rounded-full object-cover" src="/avatar.jpg" alt="" width="32" height="32" />
  </a>

  <div class="flex items-center gap-1.5">
    {currentPath !== '' && <ThemeToggle />}

    <HeaderDropdown
      name="navigation"
      label="navigation"
      title="Navigation"
      toggleId="menu-toggle"
      panelClass="w-48 max-w-[calc(100vw-32px)]"
    >
      <Fragment slot="icon">
        <LayoutGrid size={16} stroke-width={1.5} class="group-aria-expanded:hidden" />
        <X size={16} stroke-width={1.5} class="hidden group-aria-expanded:block" />
      </Fragment>
      <nav class="grid gap-px" aria-label="Main navigation">
        {destinations.map(({ slug, title }) => {
          const Icon = navigationIcons[slug] ?? Folder;
          return (
            <a class={rowClass} href={`/${slug}/`} aria-current={currentPath === `/${slug}` ? 'page' : undefined}>
              <Icon size={16} stroke-width={1.5} class="shrink-0 text-muted" />
              <span>{title}</span>
              <ArrowUpRight
                size={13}
                stroke-width={1.7}
                class="ml-auto -translate-x-0.5 translate-y-0.5 text-muted opacity-0 transition-[opacity,translate] duration-140 group-hover:translate-0 group-hover:opacity-100 group-focus-visible:translate-0 group-focus-visible:opacity-100 group-aria-[current=page]:translate-0 group-aria-[current=page]:opacity-100 motion-reduce:transition-none"
              />
            </a>
          );
        })}
      </nav>
    </HeaderDropdown>
  </div>
</header>

<script>
  import '../scripts/header';
</script>
