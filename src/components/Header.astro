---
import {
  BookOpen, Coffee, FlaskConical, Folder,
  Layers,
} from '@lucide/astro';
import HeaderDropdown from './HeaderDropdown.astro';
import { profile } from '../data/profile';
import { destinations } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const navigationIcons: Record<string, typeof Folder> = {
  projects: Folder,
  stack: Layers,
  notes: BookOpen,
  uses: Coffee,
  experiments: FlaskConical,
};
const linkClass = 'navigation-link';
---
<header class="site-header">
  <a href="/" class="identity" aria-label={`${profile.name}, home`}>
    <img class="size-8 rounded-full object-cover" src="/avatar.jpg" alt="" width="32" height="32" />
  </a>

  <div class="flex items-center gap-1.5">
    <HeaderDropdown
      name="navigation"
      label="navigation"
      toggleId="menu-toggle"
      placement="left"
      panelClass="w-max"
    >
      <Fragment slot="icon">
        <span class="menu-mark" aria-hidden="true"><span></span><span></span></span>
      </Fragment>
      <nav class="navigation-items" aria-label="Main navigation">
        {destinations.map(({ slug, title }) => {
          const Icon = navigationIcons[slug] ?? Folder;
          return (
            <a class={linkClass} data-route={slug} href={`/${slug}/`} aria-label={title} aria-current={currentPath === `/${slug}` ? 'page' : undefined}>
              <Icon size={16} stroke-width={1.6} aria-hidden="true" />
              <span class="route-label">{title}</span>
            </a>
          );
        })}
      </nav>
    </HeaderDropdown>
  </div>
  <noscript>
    <nav class="fallback-navigation" aria-label="Main navigation">
      {destinations.map(({ slug, title }) => (
        <a href={`/${slug}/`} aria-current={currentPath === `/${slug}` ? 'page' : undefined}>{title}</a>
      ))}
    </nav>
  </noscript>
</header>

<style>
  .navigation-items { display: flex; gap: 4px; }

  .navigation-link {
    --accent: #5964c7;
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 58px;
    min-height: 60px;
    padding: 8px;
    border-radius: 8px;
    color: var(--accent);
    background: transparent;
    transition: background-color 150ms ease;
    outline-offset: -3px;
  }

  .route-label { color: var(--muted); font-size: 12px; line-height: 1.4; }
  .navigation-link[aria-current='page'] .route-label { color: var(--ink); font-weight: 600; }
  .fallback-navigation { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .fallback-navigation a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; color: var(--muted); }
  .fallback-navigation a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }

  .navigation-link[data-route='projects'] { --accent: #a78040; }
  .navigation-link[data-route='stack'] { --accent: #8271ad; }
  .navigation-link[data-route='notes'] { --accent: #5a82a8; }
  .navigation-link[data-route='uses'] { --accent: #a77560; }
  .navigation-link[data-route='experiments'] { --accent: #568b78; }

  :global([data-theme='dark']) .navigation-link[data-route='projects'] { --accent: #d9b77d; }
  :global([data-theme='dark']) .navigation-link[data-route='stack'] { --accent: #b5a4d6; }
  :global([data-theme='dark']) .navigation-link[data-route='notes'] { --accent: #94b5d4; }
  :global([data-theme='dark']) .navigation-link[data-route='uses'] { --accent: #d2a28a; }
  :global([data-theme='dark']) .navigation-link[data-route='experiments'] { --accent: #90beab; }

  .navigation-link:is(:hover, :focus-visible, [aria-current='page']) {
    background: var(--surface);
    outline-color: var(--muted);
  }

  @media (max-width: 600px) {
    .navigation-items { display: grid; gap: 4px; }
    .navigation-link { flex-direction: row; justify-content: start; gap: 12px; min-height: 44px; padding: 10px 12px; }
    .route-label { font-size: 14px; }
  }

  .menu-mark {
    position: relative;
    width: 16px;
    height: 16px;
  }

  .menu-mark span {
    position: absolute;
    left: 0;
    top: 5px;
    width: 16px;
    height: 1px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .menu-mark span:last-child { top: 11px; transform: scaleX(.625); transform-origin: left; }
  :global(button:hover) .menu-mark span:last-child { transform: scaleX(1); }
  :global(button[aria-expanded='true']) .menu-mark span { transform: translateY(3px) rotate(45deg); }
  :global(button[aria-expanded='true']) .menu-mark span:last-child { transform: translateY(-3px) rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    .menu-mark span, .navigation-link { transition: none; }
  }
</style>

<script>
  import '../scripts/header';
</script>
