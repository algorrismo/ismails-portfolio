---
import {
  ArrowUpRight, BookOpen, Check, Coffee, FlaskConical, Folder,
  Layers, LayoutGrid, Monitor, Moon, Sun, X,
} from '@lucide/astro';
import HeaderDropdown from './HeaderDropdown.astro';
import { profile } from '../data/portfolio';
import { destinations } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const navigationIcons: Record<string, typeof Folder> = {
  projects: Folder,
  stack: Layers,
  notes: BookOpen,
  uses: Coffee,
  experiments: FlaskConical,
};
const themes = [
  { value: 'light', label: 'Light', Icon: Sun },
  { value: 'dark', label: 'Dark', Icon: Moon },
  { value: 'system', label: 'System', Icon: Monitor },
];
const rowClass = 'group flex min-h-8 w-full items-center gap-[9px] rounded-md bg-transparent px-2 py-1.5 text-left text-xs leading-5 text-ink hover:bg-surface aria-[current=page]:bg-surface focus-visible:-outline-offset-2 pointer-coarse:min-h-10';
---
<header class="mb-8 flex items-center justify-between">
  <a href="/" class="inline-flex" aria-label={`${profile.name}, home`}>
    <img class="size-8 rounded-full object-cover" src="/avatar.jpg" alt="" width="32" height="32" />
    <span class="sr-only">{profile.name}</span>
  </a>

  <div class="flex items-center gap-1.5">
    <HeaderDropdown
      name="appearance"
      label="appearance settings"
      title="Appearance"
      toggleId="appearance-toggle"
      panelClass="w-36"
    >
      <Fragment slot="icon">
        {themes.map(({ value, Icon }) => (
          <span data-theme-icon={value} hidden={value !== 'system'}>
            <Icon size={18} stroke-width={1.5} />
          </span>
        ))}
      </Fragment>
      <div role="group" aria-label="Appearance">
        {themes.map(({ value, label, Icon }) => (
          <button type="button" class={rowClass} data-theme-choice={value} aria-pressed="false">
            <Icon size={15} stroke-width={1.5} class="shrink-0 text-muted" />
            <span>{label}</span>
            <Check size={13} stroke-width={1.7} class="invisible ml-auto text-ink group-aria-pressed:visible" />
          </button>
        ))}
      </div>
    </HeaderDropdown>

    <HeaderDropdown
      name="navigation"
      label="navigation"
      title="Navigation"
      toggleId="menu-toggle"
      panelClass="w-max max-w-[calc(100vw-32px)]"
    >
      <Fragment slot="icon">
        <LayoutGrid size={18} stroke-width={1.5} class="group-aria-expanded:hidden" />
        <X size={18} stroke-width={1.5} class="hidden group-aria-expanded:block" />
      </Fragment>
      <nav class="grid gap-px" aria-label="Main navigation">
        {destinations.map(({ slug, title }) => {
          const Icon = navigationIcons[slug] ?? Folder;
          return (
            <a class={rowClass} href={`/${slug}/`} aria-current={currentPath === `/${slug}` ? 'page' : undefined}>
              <Icon size={20} stroke-width={1.55} class="shrink-0 -rotate-4 text-muted group-even:rotate-3" />
              <span>{title}</span>
              <ArrowUpRight
                size={13}
                stroke-width={1.7}
                class="ml-auto -translate-x-0.5 translate-y-0.5 text-muted opacity-0 transition-[opacity,translate] duration-[140ms] group-hover:translate-0 group-hover:opacity-100 group-focus-visible:translate-0 group-focus-visible:opacity-100 group-aria-[current=page]:translate-0 group-aria-[current=page]:opacity-100 motion-reduce:transition-none"
              />
            </a>
          );
        })}
      </nav>
    </HeaderDropdown>
  </div>
</header>

<script>
  import '../scripts/header';
</script>
