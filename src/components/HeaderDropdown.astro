---
interface Props {
  name: 'appearance' | 'navigation';
  label: string;
  title?: string;
  toggleId: string;
  panelClass: string;
  placement?: 'top' | 'bottom' | 'left';
}

const { name, label, title, toggleId, panelClass, placement = 'bottom' } = Astro.props;
const panelId = `${name}-panel`;
---
<div class="dropdown relative" data-dropdown={name} data-placement={placement}>
  <button
    type="button"
    id={toggleId}
    class="group relative grid size-11 place-items-center rounded-full bg-transparent p-3 text-muted transition-colors duration-150 hover:bg-surface hover:text-ink aria-expanded:bg-surface aria-expanded:text-ink motion-reduce:transition-none"
    data-dropdown-toggle
    data-dropdown-label={label}
    aria-label={`Open ${label}`}
    aria-controls={panelId}
    aria-expanded="false"
    title={title}
    hidden
  >
    <slot name="icon" />
  </button>
  <div
    id={panelId}
    class:list={['dropdown-panel', panelClass]}
    data-dropdown-panel
    hidden
  >
    <slot />
  </div>
</div>

<style>
  .dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 40;
    max-width: calc(100vw - 40px);
    max-height: calc(100svh - 100px);
    overflow: auto;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--background);
    box-shadow: 0 8px 28px rgb(0 0 0 / 8%);
    animation: dropdown-enter 160ms ease-out;
  }

  [data-placement='top'] .dropdown-panel { top: auto; bottom: calc(100% + 8px); }
  [data-placement='left'] .dropdown-panel { top: 50%; right: calc(100% + 12px); transform: translateY(-50%); }

  @keyframes dropdown-enter {
    from { opacity: 0; translate: 0 -4px; }
    to { opacity: 1; translate: 0 0; }
  }

  @media (max-width: 600px) {
    [data-placement='left'] .dropdown-panel {
      top: calc(100% + 8px);
      right: 0;
      width: min(240px, calc(100vw - 40px));
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel { animation: none; }
  }
</style>
